<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Snapshots</h1>
    <%= link_to "Novo Snapshot", new_snapshot_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <table class="min-w-full bg-white border border-gray-200">
    <thead>
      <tr class="bg-gray-100">
        <th class="px-4 py-2 text-left border-b">Data</th>
        <th class="px-4 py-2 text-left border-b">Notas</th>
        <th class="px-4 py-2 text-right border-b">Total</th>
        <th class="px-4 py-2 text-right border-b">Total Líquido</th>
        <th class="px-4 py-2 text-left border-b">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @snapshots.each do |snapshot| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2 border-b">
            <%= link_to snapshot.taken_on.strftime("%d/%m/%Y"), snapshot_path(snapshot), class: "text-blue-600 hover:underline" %>
          </td>
          <td class="px-4 py-2 border-b text-gray-600"><%= snapshot.notes %></td>
          <td class="px-4 py-2 border-b text-right"><%= brl_currency(snapshot.total_brl_cents) %></td>
          <td class="px-4 py-2 border-b text-right"><%= brl_currency(snapshot.liquid_total_brl_cents) %></td>
          <td class="px-4 py-2 border-b space-x-2">
            <%= link_to "Editar", edit_snapshot_path(snapshot), class: "text-gray-600 hover:underline" %>
            <%= link_to "Excluir", snapshot_path(snapshot), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }, class: "text-red-600 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
