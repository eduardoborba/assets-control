<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Assets Control" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Assets Control">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="bg-white border-b border-gray-200 px-4 py-3">
      <div class="container mx-auto flex items-center space-x-6">
        <div class="flex items-center space-x-2">
          <%= image_tag "stonks.png", alt: "Stonks", class: "h-10 w-10 rounded" %>
          <span class="font-bold text-lg">Assets Control</span>
        </div>
        <%= link_to "Dashboard", root_path, class: "text-gray-600 hover:text-gray-900" %>
        <%= link_to "Ativos", financial_assets_path, class: "text-gray-600 hover:text-gray-900" %>
        <%= link_to "Snapshots", snapshots_path, class: "text-gray-600 hover:text-gray-900" %>
      </div>
    </nav>

    <main class="container mx-auto mt-8 px-5">
      <% if notice.present? %>
        <div class="bg-green-50 border border-green-200 text-green-800 rounded p-4 mb-4">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="bg-red-50 border border-red-200 text-red-800 rounded p-4 mb-4">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
